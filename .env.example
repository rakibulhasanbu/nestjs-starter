# Application
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000

# Database (PostgreSQL)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>?schema=public
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nest_starter?schema=public"

# Auth
JWT_ACCESS_SECRET=change-me-to-a-random-32-byte-hex-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

EMAIL_VERIFICATION_TTL_HOURS=24
PASSWORD_RESET_TTL_MINUTES=30

LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Google Sign-In (OAuth2 client ID from Google Cloud Console)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# WebAuthn / Passkeys
WEBAUTHN_RP_ID=localhost
WEBAUTHN_RP_NAME=Nest Starter
WEBAUTHN_ORIGIN=http://localhost:3000
WEBAUTHN_CHALLENGE_TTL_MINUTES=5

# Seed-only super admin bootstrap (see prisma/seed.ts) — not usable to create further admins
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-please-1234
